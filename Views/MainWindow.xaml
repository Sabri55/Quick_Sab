<Window x:Class="Quick_Sab.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick_Sab"
        Width="720" Height="560" MinWidth="480" MinHeight="320"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Background="{StaticResource BgBrush}">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Margin="0,0,0,10" Background="Transparent" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚡ Quick_Sab" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="HotkeyLabel" Text="" Margin="12,0,0,0" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE72E;" FontSize="14" ToolTip="AES encrypt / decrypt" Click="Crypto_Click" />
                <Button Grid.Column="3" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE7B8;" FontSize="14" ToolTip="Package compare" Click="PackageCompare_Click" />
                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="⚙" ToolTip="Settings" Click="Config_Click" />
                <Button Grid.Column="5" Style="{StaticResource IconButton}" Content="✕" ToolTip="Hide (Esc)" Click="Hide_Click" />
            </Grid>

            <!-- Filter -->
            <Border Grid.Row="1" Margin="0,0,0,10" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,6">
                <Grid>
                    <TextBlock x:Name="Placeholder" Text="Type a key... (Enter to run, Tab to complete, Ctrl+P to pin)"
                               FontSize="22" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                    <TextBox x:Name="FilterBox" FontSize="26" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource FgBrush}" CaretBrush="{StaticResource FgBrush}"
                             VerticalContentAlignment="Center"
                             TextChanged="FilterBox_TextChanged" PreviewKeyDown="FilterBox_PreviewKeyDown" />
                </Grid>
            </Border>

            <!-- Suggestions / autocomplete -->
            <ListBox Grid.Row="2" x:Name="SuggestionList" Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Focusable" Value="False" />
                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Suggestion_Click" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="10,8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3B3B52" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#34344A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="6" CornerRadius="3" Margin="0,0,10,0"
                                    Background="{Binding Type, Converter={StaticResource TypeBrush}}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Key}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" />
                                <TextBlock Text="{Binding ValueDisplay}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           FontStyle="Italic" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Description}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Border Grid.Column="2" Background="{Binding Type, Converter={StaticResource TypeBrush}}"
                                    CornerRadius="10" Padding="10,3" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="{Binding Type}" FontSize="11" FontWeight="Bold" Foreground="White" />
                            </Border>
                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="📌" FontSize="15"
                                    Margin="6,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Pin / unpin this shortcut in a panel" Click="PinMenu_Click" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Pinned panels -->
            <Border Grid.Row="3" Margin="0,10,0,0" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PINNED PANELS" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="＋ New panel" Width="Auto" Height="24"
                                FontSize="12" Padding="8,0" ToolTip="Create a new pinned panel" Click="NewPanel_Click" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="220">
                        <ItemsControl x:Name="PanelsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4,0,4">
                                        <!-- Panel header -->
                                        <Grid Margin="0,0,0,4" Background="Transparent">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Rename panel..." Click="RenamePanel_Click" />
                                                    <MenuItem Header="Move up" Click="MovePanelUp_Click" />
                                                    <MenuItem Header="Move down" Click="MovePanelDown_Click" />
                                                    <Separator />
                                                    <MenuItem Header="Delete panel" Click="DeletePanel_Click" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource FgBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="11" Margin="8,0,0,0"
                                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="✎" Width="24" Height="22" FontSize="12"
                                                    ToolTip="Rename panel" Click="RenamePanel_Click" />
                                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="✕" Width="24" Height="22" FontSize="12"
                                                    ToolTip="Delete panel" Click="DeletePanel_Click" />
                                        </Grid>

                                        <!-- Chips -->
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding Item.Type, Converter={StaticResource TypeBrush}}"
                                                            CornerRadius="14" Margin="0,0,8,8" ToolTip="{Binding Item.Value}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Style="{StaticResource ChipButton}" Content="{Binding Item.Key}" Click="Pinned_Click" />
                                                            <Button Style="{StaticResource ChipCloseButton}" Content="✕" ToolTip="Unpin" Click="Unpin_Click" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Empty — use the 📌 button on a suggestion to pin a shortcut here."
                                                   FontSize="11" FontStyle="Italic" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Git repositories -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="GIT REPO" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox Grid.Column="1" x:Name="GitRepoCombo" VerticalContentAlignment="Center"
                                  ToolTip="Double-click to open the selected repository folder"
                                  SelectionChanged="GitRepoCombo_SelectionChanged"
                                  MouseDoubleClick="GitRepoCombo_MouseDoubleClick">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Path}" Margin="8,0,0,0" Opacity="0.6" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                FontFamily="Segoe MDL2 Assets" Content="&#xE946;" FontSize="11"
                                Width="24" Height="22" Margin="6,0,0,0"
                                ToolTip="About Quick_Sab" Click="About_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
