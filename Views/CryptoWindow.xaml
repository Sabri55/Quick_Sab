<Window x:Class="Quick_Sab.Views.CryptoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick_Sab - AES Encrypt / Decrypt"
        Width="640" Height="500" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="StatusText" Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,8" />

        <GroupBox Grid.Row="1" Header="Input (plain text to encrypt, or Base64 to decrypt)">
            <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="4" />
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
            <Button Content="🔒 Encrypt ▼" Padding="14,6" Margin="0,0,8,0" Click="Encrypt_Click" />
            <Button Content="🔓 Decrypt ▼" Padding="14,6" Margin="0,0,8,0" Click="Decrypt_Click" />
            <Button Content="⇅ Use result as input" Padding="14,6" Click="Swap_Click" />
        </StackPanel>

        <GroupBox Grid.Row="3" Header="Result">
            <TextBox x:Name="OutputBox" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="4" Background="#F5F5F5" />
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Copy result" Padding="14,6" Margin="0,0,8,0" Click="Copy_Click" />
            <Button Content="Close" Padding="14,6" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
