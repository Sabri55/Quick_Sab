<Window x:Class="Quick_Sab.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:models="clr-namespace:Quick_Sab.Models"
        Title="Quick_Sab - Settings"
        Width="900" Height="620" MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <ObjectDataProvider x:Key="ActionTypes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ActionType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ScriptShells" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ScriptShell" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="True" />
            <Setter Property="CanUserDeleteRows" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="RowHeight" Value="26" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <!-- ===================== ACTIONS ===================== -->
            <TabItem Header="Actions">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Hint}">
                        Each row is a key / value entry. Values and the working directory accept variables:
                        {{git_path_1}}, {{git_name_1}}, {{repo_name}}, {{git:name}}, {{my_variable}}, {{env:USERPROFILE}}.
                    </TextBlock>
                    <DataGrid Grid.Row="1" x:Name="ItemsGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                            <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                                    ItemsSource="{Binding Source={StaticResource ActionTypes}}" Width="100" />
                            <DataGridTextColumn Header="Value (path / URL / command)" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                            <DataGridTextColumn Header="Working dir (Command)" Binding="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                            <DataGridCheckBoxColumn Header="Keep cmd open" Binding="{Binding KeepWindowOpen, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="+ Add" Padding="10,4" Margin="0,0,8,0" Click="AddItem_Click" />
                        <Button Content="- Remove" Padding="10,4" Margin="0,0,8,0" Click="RemoveItem_Click" />
                        <Button Content="▲" Padding="10,4" Margin="0,0,4,0" Click="MoveItemUp_Click" ToolTip="Move up" />
                        <Button Content="▼" Padding="10,4" Click="MoveItemDown_Click" ToolTip="Move down" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===================== PANELS ===================== -->
            <TabItem Header="Panels">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Hint}">
                        Named panels shown at the bottom of the launcher. Pin / unpin shortcuts from the launcher itself
                        (📌 button on a suggestion, ✕ on a pinned chip).
                    </TextBlock>
                    <DataGrid Grid.Row="1" x:Name="PanelsGrid" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                            <DataGridTextColumn Header="Pinned keys" Binding="{Binding KeysDisplay}" IsReadOnly="True" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="+ Add" Padding="10,4" Margin="0,0,8,0" Click="AddPanel_Click" />
                        <Button Content="- Remove" Padding="10,4" Margin="0,0,8,0" Click="RemovePanel_Click" />
                        <Button Content="▲" Padding="10,4" Margin="0,0,4,0" Click="MovePanelUp_Click" ToolTip="Move up" />
                        <Button Content="▼" Padding="10,4" Click="MovePanelDown_Click" ToolTip="Move down" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===================== GIT ===================== -->
            <TabItem Header="Git repositories">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Hint}">
                        Local git repositories. The 1st one is {{git_path_1}}, the 2nd {{git_path_2}}, and so on.
                        A repository name can also be used directly: {{name}} or {{git:name}}.
                    </TextBlock>
                    <DataGrid Grid.Row="1" x:Name="ReposGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" IsReadOnly="True" Width="40"
                                                Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                            <DataGridTextColumn Header="Path" Binding="{Binding Path, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="+ Browse folder..." Padding="10,4" Margin="0,0,8,0" Click="AddRepo_Click" />
                        <Button Content="- Remove" Padding="10,4" Margin="0,0,8,0" Click="RemoveRepo_Click" />
                        <Button Content="▲" Padding="10,4" Margin="0,0,4,0" Click="MoveRepoUp_Click" />
                        <Button Content="▼" Padding="10,4" Click="MoveRepoDown_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===================== VARIABLES ===================== -->
            <TabItem Header="Variables">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Hint}">
                        Free variables usable as {{name}} in values.
                    </TextBlock>
                    <DataGrid Grid.Row="1" x:Name="VarsGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="+ Add" Padding="10,4" Margin="0,0,8,0" Click="AddVar_Click" />
                        <Button Content="- Remove" Padding="10,4" Click="RemoveVar_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===================== HOTKEY & OPTIONS ===================== -->
            <TabItem Header="Hotkey &amp; options">
                <StackPanel Margin="12" MaxWidth="600" HorizontalAlignment="Left">
                    <TextBlock Text="Global hotkey (show / hide)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Hint}">
                        Pick 1 or 2 modifiers, then click in the box and press the final key (e.g. Ctrl + Alt + Space).
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox x:Name="CtrlBox" Content="Ctrl" Margin="0,0,16,0" VerticalAlignment="Center" Checked="Modifier_Changed" Unchecked="Modifier_Changed" />
                        <CheckBox x:Name="AltBox" Content="Alt" Margin="0,0,16,0" VerticalAlignment="Center" Checked="Modifier_Changed" Unchecked="Modifier_Changed" />
                        <CheckBox x:Name="ShiftBox" Content="Shift" Margin="0,0,16,0" VerticalAlignment="Center" Checked="Modifier_Changed" Unchecked="Modifier_Changed" />
                        <CheckBox x:Name="WinBox" Content="Win" Margin="0,0,16,0" VerticalAlignment="Center" Checked="Modifier_Changed" Unchecked="Modifier_Changed" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Key:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="KeyBox" Width="160" IsReadOnly="True" Padding="6,4"
                                 ToolTip="Click here then press a key" PreviewKeyDown="KeyBox_PreviewKeyDown" />
                        <TextBlock Text="Preview:" VerticalAlignment="Center" Margin="16,0,8,0" />
                        <TextBlock x:Name="HotkeyPreview" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>

                    <Separator Margin="0,12" />
                    <TextBlock Text="Behaviour" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                    <CheckBox x:Name="HideAfterActionBox" Content="Hide the window automatically after an action runs" Margin="0,0,0,6" />
                    <CheckBox x:Name="HideOnFocusLostBox" Content="Hide the window when it loses focus" Margin="0,0,0,6" />

                    <Separator Margin="0,12" />
                    <TextBlock Text="Configuration file" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                    <TextBox x:Name="ConfigPathBox" IsReadOnly="True" Padding="6,4" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open folder" Padding="10,4" Margin="0,0,8,0" Click="OpenConfigFolder_Click" />
                        <Button Content="Open config.json" Padding="10,4" Click="OpenConfigFile_Click" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- ===================== CRYPTO ===================== -->
            <TabItem Header="Crypto (AES)">
                <StackPanel Margin="12" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Text="AES encryption (AES-256-CBC)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Hint}">
                        Key and IV used by the encrypt / decrypt window (\U0001F510 button in the launcher).
                        The Key must be exactly 32 characters and the IV 16 characters (ASCII).
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Key (32 chars):" Width="110" VerticalAlignment="Center" />
                        <TextBox x:Name="AesKeyBox" Width="380" Padding="6,4" FontFamily="Consolas"
                                 MaxLength="32" TextChanged="Aes_TextChanged" />
                        <TextBlock x:Name="AesKeyCount" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#666" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                        <TextBlock Text="IV (16 chars):" Width="110" VerticalAlignment="Center" />
                        <TextBox x:Name="AesIvBox" Width="380" Padding="6,4" FontFamily="Consolas"
                                 MaxLength="16" TextChanged="Aes_TextChanged" />
                        <TextBlock x:Name="AesIvCount" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#666" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Generate random Key + IV" Padding="10,4" Click="GenerateAes_Click" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0">
                        \u26A0 The Key and IV are stored in plain text in config.json.
                    </TextBlock>
                </StackPanel>
            </TabItem>

            <!-- ===================== SCRIPTS ===================== -->
            <TabItem Header="Scripts">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Hint}">
                        Named scripts run with cmd (.bat) or PowerShell (.ps1), callable from the launcher filter by
                        their name (Enter runs them, they can
                        also be pinned to panels). {{variables}} are resolved in the content and the working directory
                        before execution.
                    </TextBlock>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox Grid.Row="0" x:Name="ScriptsList" DisplayMemberPath="Name"
                                     SelectionChanged="ScriptsList_SelectionChanged" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="+ Add" Padding="10,4" Margin="0,0,8,0" Click="AddScript_Click" />
                                <Button Content="- Remove" Padding="10,4" Click="RemoveScript_Click" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Column="1" x:Name="ScriptEditor" IsEnabled="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Name:" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Description:" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                            </Grid>
                            <Grid Grid.Row="2" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Working dir:" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"
                                         ToolTip="Optional. Supports {{variables}}, e.g. {{CurrentGitRepo}}" />
                            </Grid>
                            <Grid Grid.Row="3" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Run with:" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                          ItemsSource="{Binding Source={StaticResource ScriptShells}}"
                                          SelectedItem="{Binding Shell}" />
                            </Grid>
                            <CheckBox Grid.Row="4" Content="Keep window open after execution"
                                      IsChecked="{Binding KeepWindowOpen}" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="5" Text="Script content:" Margin="0,0,0,4" />
                            <TextBox Grid.Row="6" Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" Padding="6,4" />
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===================== PACKAGES ===================== -->
            <TabItem Header="Packages" x:Name="PackagesTab">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Hint}">
                        Entries of the source folder whose name matches one of the regexes are compared with the
                        target folder; the version is the trailing part of the name starting with a digit
                        (e.g. package_5.2_up). Paths accept {{variables}}; the target is available as {{PathTarget}},
                        the source as {{PathSource}}.
                    </TextBlock>

                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Source path:" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="PkgSourceBox" Padding="6,4" />
                        <Button Grid.Column="2" Content="Browse..." Padding="10,4" Margin="8,0,0,0" Click="BrowsePkgSource_Click" />
                        <Button Grid.Column="3" Content="Open" Padding="10,4" Margin="8,0,0,0"
                                ToolTip="Open the (variable-resolved) folder in Explorer" Click="OpenPkgSource_Click" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Target path:" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="PkgTargetBox" Padding="6,4" />
                        <Button Grid.Column="2" Content="Browse..." Padding="10,4" Margin="8,0,0,0" Click="BrowsePkgTarget_Click" />
                        <Button Grid.Column="3" Content="Open" Padding="10,4" Margin="8,0,0,0"
                                ToolTip="Open the (variable-resolved) folder in Explorer" Click="OpenPkgTarget_Click" />
                    </Grid>

                    <TextBlock Grid.Row="3" Text="Package name patterns (regex, empty list = all entries):" Margin="0,6,0,4" />
                    <DataGrid Grid.Row="4" x:Name="PatternsGrid" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Regex" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="5" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="+ Add" Padding="10,4" Margin="0,0,8,0" Click="AddPattern_Click" />
                            <Button Content="- Remove" Padding="10,4" Click="RemovePattern_Click" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="PkgCompareButton" Content="Compare..." Padding="16,4"
                                FontWeight="SemiBold" ToolTip="Open the comparison in its own window"
                                Click="PkgCompare_Click" />
                    </Grid>

                </Grid>
            </TabItem>

            <!-- ===================== COLOURS ===================== -->
            <TabItem Header="Colors">
                <StackPanel Margin="12" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource Hint}">
                        Color for each action type (hex format, e.g. #3B82F6).
                    </TextBlock>
                    <ItemsControl x:Name="ColorsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBox Grid.Column="1" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                                    <Border Grid.Column="2" Width="60" Height="26" Margin="8,0" CornerRadius="4" BorderBrush="#888" BorderThickness="1"
                                            Background="{Binding Hex, Converter={StaticResource HexBrush}}" />
                                    <Button Grid.Column="3" Content="Pick..." Padding="10,4" Click="PickColor_Click" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Padding="16,6" Margin="0,0,8,0" IsDefault="True" Click="Save_Click" />
            <Button Content="Cancel" Padding="16,6" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
