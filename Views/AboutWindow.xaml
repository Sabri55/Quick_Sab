<Window x:Class="Quick_Sab.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Quick_Sab"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="24,20">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="⚡" FontSize="26" VerticalAlignment="Center" Margin="0,0,8,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Quick_Sab" FontSize="22" FontWeight="Bold" />
                <TextBlock x:Name="VersionText" Foreground="#666" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="Quick launcher for shortcuts, commands, scripts, git repositories, AES tools and package updates."
                   TextWrapping="Wrap" Foreground="#444" Margin="0,12,0,0" />

        <Separator Margin="0,16,0,16" />

        <TextBlock Text="Developed by" FontSize="11" FontWeight="Bold" Foreground="#888" />
        <TextBlock Text="Sabri BENMILOUD" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="✉" Width="22" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center">
                <Hyperlink NavigateUri="mailto:s.benmiloud@gmail.com" RequestNavigate="Link_RequestNavigate">s.benmiloud@gmail.com</Hyperlink>
            </TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="in" Width="22" FontWeight="Bold" Foreground="#0A66C2" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center">
                <Hyperlink NavigateUri="https://www.linkedin.com/in/benmiloud-sabri-9756a079/" RequestNavigate="Link_RequestNavigate">linkedin.com/in/benmiloud-sabri-9756a079</Hyperlink>
            </TextBlock>
        </StackPanel>

        <Button Content="Close" Padding="16,6" HorizontalAlignment="Right" Margin="0,18,0,0" IsCancel="True" IsDefault="True" />
    </StackPanel>
</Window>
